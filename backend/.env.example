# Configuración de DataExtractor AI
# Copia este archivo a .env y configura tus valores

# OpenAI API (para extracción inteligente con GPT-4 Vision)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-vision-preview

# Configuración de Tesseract OCR (opcional si está en PATH)
# TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=spa+eng

# Límites de archivos
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_BATCH=50

# Modo debug
DEBUG=true

# CORS (separar múltiples orígenes con coma)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
